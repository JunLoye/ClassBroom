{
  "applicationId": "com.junloye.classbroom",
  "version": "1.2.0",
  "defaultMode": "window",
  "port": 0,
  "documentRoot": "/www/",
  "url": "/",
  "enableServer": true,
  "enableNativeAPI": true,
  "tokenSecurity": "one-time",
  "nativeAllowList": [
    "app.*",
    "os.execCommand",
    "os.*",
    "filesystem.*",
    "window.*"
  ],
  "modes": {
    "window": {
      "title": "ClassBroom",
      "icon": "www/app.ico",
      "width": 1400,
      "height": 92,
      "minWidth": 800,
      "minHeight": 70,
      "resizable": false,
      "fullScreen": false,
      "alwaysOnTop": false,
      "borderless": true,
      "transparent": true,
      "skipTaskbar": true,
      "enableInspector": false 
    }
  },
  "cli": {
    "binaryName": "classbroom",
    "resourcesPath": "/www/",
    "clientLibrary": "/www/js/neutralino.js",
    "binaryVersion": "6.10.0",
    "clientVersion": "6.10.0"
  }
}
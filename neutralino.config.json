{
  "applicationId": "com.junloye.classbroom",
  "version": "2.2.1",
  "applicationName": "ClassBroom",
  "description": "ClassBroom - 桌面课程与天气挂件",
  "author": "JunLoye",
  "copyright": "Copyright © 2026 JunLoye",
  "defaultMode": "window",
  "port": 0,
  "documentRoot": "/www/",
  "url": "/",
  "enableServer": true,
  "enableNativeAPI": true,
  "tokenSecurity": "one-time",
  "nativeAllowList": [
    "app.exit",
    "os.execCommand",
    "os.getEnv",
    "os.open",
    "os.setTray",
    "os.showOpenDialog",
    "os.showSaveDialog",
    "filesystem.appendFile",
    "filesystem.createDirectory",
    "filesystem.getAbsolutePath",
    "filesystem.getJoinedPath",
    "filesystem.getStats",
    "filesystem.move",
    "filesystem.readBinaryFile",
    "filesystem.readFile",
    "filesystem.remove",
    "filesystem.writeBinaryFile",
    "filesystem.writeFile",
    "window.beginDrag",
    "window.center",
    "window.focus",
    "window.getPosition",
    "window.getSize",
    "window.hide",
    "window.move",
    "window.setDraggableRegion",
    "window.setSize",
    "window.show",
    "window.unsetDraggableRegion"
  ],
  "modes": {
    "window": {
      "title": "ClassBroom",
      "icon": "www/app.ico",
      "width": 1400,
      "height": 92,
      "minWidth": 800,
      "minHeight": 70,
      "resizable": false,
      "fullScreen": false,
      "alwaysOnTop": false,
      "borderless": true,
      "transparent": true,
      "skipTaskbar": true,
      "enableInspector": false
    }
  },
  "cli": {
    "binaryName": "classbroom",
    "resourcesPath": "/www/",
    "clientLibrary": "/www/js/neutralino.js",
    "binaryVersion": "6.10.0",
    "clientVersion": "6.10.0"
  }
}